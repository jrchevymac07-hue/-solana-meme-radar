# DexScreener's public API works without a key for the initial beta.
# Set this only to route requests through a compatible paid/provider endpoint.
DEXSCREENER_API_URL=https://api.dexscreener.com

# PostgreSQL connection used only by server-side snapshot/history code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Long random value used only by Vercel Cron and protected manual collection calls.
CRON_SECRET=replace-with-a-long-random-secret

# Independent public-wallet research collector. No FOMO login/session is used.
TRADER_TRACKING_ENABLED=false
TRADER_CRON_SECRET=
# Production RPC provider for Robinhood Chain (4663), supporting finalized + eth_getLogs.
TRADER_RPC_URL=
# Optional first-run historical start; otherwise starts with the latest 10,000 finalized blocks.
TRADER_START_BLOCK=
# Maximum contiguous blocks per invocation (1-10000); reduce if the RPC rejects large log ranges.
TRADER_BLOCK_SPAN=10000

# Independent social research (disabled until API access is configured)
SOCIAL_MONITORING_ENABLED=false
SOCIAL_CRON_SECRET=
X_MONITOR_HANDLE=PonsVault
X_BEARER_TOKEN=
INSTAGRAM_MONITOR_HANDLE=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VIEWER_ACCOUNT_ID=
META_GRAPH_VERSION=
