generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TokenSnapshot {
  id                       String   @id @default(cuid())
  tokenAddress             String
  symbol                   String
  name                     String
  timestamp                DateTime @default(now())
  snapshotBucket           DateTime
  priceUsd                 Float
  liquidityUsd             Float
  volume24h                Float
  priceChange24h           Float
  buys24h                  Int
  sells24h                 Int
  tokenAge                 Float
  radarScore               Int
  liquidityMetricScore     Float
  volumeMomentumScore      Float
  priceMomentumScore       Float
  tokenAgeScore             Float
  transactionActivityScore Float
  riskScore                Float
  interpretationLabel      String
  outcomes                 TokenOutcome[]

  @@unique([tokenAddress, snapshotBucket])
  @@index([tokenAddress, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}

enum OutcomeStatus {
  STRONG_GAIN
  GAIN
  FLAT
  LOSS
  STRONG_LOSS
  UNAVAILABLE
}

model TokenOutcome {
  id              String        @id @default(cuid())
  snapshotId      String
  tokenAddress    String
  symbol          String
  horizonHours    Int
  targetTimestamp DateTime
  evaluatedAt     DateTime      @default(now())
  entryPriceUsd   Float
  outcomePriceUsd Float?
  returnPercent   Float?
  status          OutcomeStatus
  snapshot        TokenSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, horizonHours])
  @@index([tokenAddress, horizonHours, evaluatedAt(sort: Desc)])
  @@index([status, horizonHours])
}
