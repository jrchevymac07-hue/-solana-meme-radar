generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TokenSnapshot {
  id                       String   @id @default(cuid())
  tokenAddress             String
  symbol                   String
  name                     String
  timestamp                DateTime @default(now())
  snapshotBucket           DateTime
  priceUsd                 Float
  liquidityUsd             Float
  volume24h                Float
  priceChange24h           Float
  buys24h                  Int
  sells24h                 Int
  tokenAge                 Float
  radarScore               Int
  liquidityMetricScore     Float
  volumeMomentumScore      Float
  priceMomentumScore       Float
  tokenAgeScore             Float
  transactionActivityScore Float
  riskScore                Float
  interpretationLabel      String

  @@unique([tokenAddress, snapshotBucket])
  @@index([tokenAddress, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}
